{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "id",
    "candidate",
    "contract",
    "oracle",
    "confirmation",
    "provider",
    "reducers",
    "fingerprint",
    "replayability"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "kind": {
      "const": "finding"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "candidate": {
      "$ref": "artifacts-v2.schema.json#/$defs/candidate"
    },
    "contract": {
      "$ref": "artifacts-v2.schema.json#/$defs/contract"
    },
    "oracle": {
      "$ref": "artifacts-v2.schema.json#/$defs/oracle"
    },
    "confirmation": {
      "$ref": "artifacts-v2.schema.json#/$defs/confirmation"
    },
    "provider": {
      "enum": [
        "typesafe",
        "cloudflare",
        "custom"
      ]
    },
    "policy": {
      "$ref": "campaign-v2.schema.json#/$defs/policy"
    },
    "reducers": {
      "$ref": "artifacts-v2.schema.json#/$defs/reducers"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "replayability": {
      "const": "full"
    },
    "parentFindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevfuzz.dev/schema/finding-v2.schema.json"
}
