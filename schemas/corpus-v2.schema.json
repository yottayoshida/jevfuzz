{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "kind": {
      "const": "corpus"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pairHash",
          "evidence",
          "sourceFindingIds",
          "triage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pairHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "sourceFindingIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "triage": {
            "$ref": "artifacts-v2.schema.json#/$defs/triage"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevfuzz.dev/schema/corpus-v2.schema.json"
}
