        "features": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "$ref": "#/$defs/feedback"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "signatures": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "observations",
                  "candidateId",
                  "bytes"
                ],
                "properties": {
                  "observations": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "candidateId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
