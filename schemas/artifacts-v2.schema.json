{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevfuzz.dev/schema/artifacts-v2.schema.json",
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "relation",
        "projection",
        "mutations",
        "admissibility",
        "assumptions",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "invariant",
            "equivariant",
            "bounded_shift",
            "directional"
          ]
        },
        "projection": {
          "enum": [
            "choice",
            "noul",
            "score",
            "policy"
          ]
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "question_id_rename",
              "question_order",
              "choice_criteria_order",
              "object_key_order",
              "unordered_array_shuffle",
              "irrelevant_field_injection",
              "text_normalization",
              "choice_label_rename",
              "proposal"
            ]
          }
        },
        "admissibility": {
          "enum": [
            "structural",
            "declared",
            "hypothesis"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "minimumEffect": {
          "type": "number",
          "minimum": 0
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "increase",
            "decrease"
          ]
        },
        "labelMapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "paired-v1",
            "fixed-stat-v1"
          ]
        },
        "pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1023
        },
        "minimumSupport": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maxControlViolationRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumEffect": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "originalSlots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "shrinkSlots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "profile",
        "pairs",
        "minimumSupport",
        "maxControlViolationRate",
        "minimumEffect",
        "alpha",
        "originalSlots",
        "shrinkSlots"
      ]
    },
    "reducers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "independentQuestions": {
          "type": "boolean"
        },
        "optionalStatePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unorderedArrayPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prosePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "independentQuestions",
        "optionalStatePaths",
        "unorderedArrayPaths",
        "prosePaths"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "version",
        "admissibility",
        "reads",
        "writes",
        "requires",
        "invalidates"
      ],
      "properties": {
        "operator": {
          "enum": [
            "question_id_rename",
            "question_order",
            "choice_criteria_order",
            "object_key_order",
            "unordered_array_shuffle",
            "irrelevant_field_injection",
            "text_normalization",
            "choice_label_rename",
            "proposal"
          ]
        },
        "version": {
          "const": "1"
        },
        "admissibility": {
          "enum": [
            "structural",
            "declared",
            "hypothesis"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "order": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "renames": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "value": {
          "$ref": "common-v2.schema.json#/$defs/json"
        },
        "text": {
          "type": "string"
        },
        "orders": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "order"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "order": {
                "type": "array",
                "minItems": 0,
                "maxItems": 100000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "reads": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "writes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "requires": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "invalidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seedId",
        "basePayload",
        "mutantPayload",
        "baseWireHash",
        "mutantWireHash",
        "contentHash",
        "contractHash",
        "targetHash",
        "recipe",
        "contractIds",
        "contracts",
        "questionMap",
        "labelMaps",
        "admissibility",
        "provenanceHash",
        "assumptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "seedId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "basePayload": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "mutantPayload": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "baseWireHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mutantWireHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "contractIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "questionMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "labelMaps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "admissibility": {
          "enum": [
            "structural",
            "declared",
            "hypothesis"
          ]
        },
        "provenanceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assumptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "usage",
        "answers"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "choice",
                  "confidence",
                  "probabilities"
                ],
                "properties": {
                  "type": {
                    "const": "choice"
                  },
                  "choice": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "probabilities": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "noul"
                ],
                "properties": {
                  "type": {
                    "const": "noul"
                  },
                  "noul": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "score",
                  "confidence",
                  "probabilities",
                  "legend"
                ],
                "properties": {
                  "type": {
                    "const": "score"
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "probabilities": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "legend": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "common-v2.schema.json#/$defs/content"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operationId",
        "phase",
        "wireHash",
        "response",
        "provider",
        "observedModel",
        "cache"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "phase": {
          "enum": [
            "discovery",
            "confirmation",
            "shrink",
            "final-confirmation"
          ]
        },
        "wireHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transportWireHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "observedModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cache": {
          "enum": [
            "unknown",
            "fresh",
            "cached"
          ]
        },
        "transportUncertain": {
          "type": "boolean"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "holds",
            "violates",
            "unknown"
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "effect": {
          "type": "number"
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "before": {
          "type": [
            "string",
            "number"
          ]
        },
        "after": {
          "type": [
            "string",
            "number"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "control",
        "b",
        "violation",
        "sham"
      ],
      "properties": {
        "a": {
          "$ref": "#/$defs/observation"
        },
        "control": {
          "$ref": "#/$defs/observation"
        },
        "b": {
          "$ref": "#/$defs/observation"
        },
        "violation": {
          "$ref": "#/$defs/relation"
        },
        "sham": {
          "$ref": "#/$defs/relation"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason",
        "signature",
        "evidenceLevel",
        "profileVersion",
        "discoverySamples",
        "confirmationSamples",
        "controls",
        "support",
        "controlViolations",
        "effect",
        "familySize",
        "adjustment",
        "assumptions",
        "blocks",
        "observedModels"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NO_CONFIRMED_VIOLATION"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidenceLevel": {
          "enum": [
            "empirical",
            "statistical"
          ]
        },
        "profileVersion": {
          "enum": [
            "paired-v1",
            "fixed-stat-v1"
          ]
        },
        "discoverySamples": {
          "type": "integer",
          "minimum": 0
        },
        "confirmationSamples": {
          "type": "integer",
          "minimum": 0
        },
        "controls": {
          "type": "integer",
          "minimum": 0
        },
        "support": {
          "type": "integer",
          "minimum": 0
        },
        "controlViolations": {
          "type": "integer",
          "minimum": 0
        },
        "effect": {
          "type": "number"
        },
        "familySize": {
          "type": "integer",
          "minimum": 0
        },
        "adjustment": {
          "enum": [
            "none",
            "bonferroni"
          ]
        },
        "slotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pValue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "blocks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1023,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "observedModels": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "id",
        "candidate",
        "contract",
        "oracle",
        "confirmation",
        "provider",
        "reducers",
        "fingerprint",
        "replayability"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "kind": {
          "const": "finding"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "confirmation": {
          "$ref": "#/$defs/confirmation"
        },
        "provider": {
          "enum": [
            "typesafe",
            "cloudflare",
            "custom"
          ]
        },
        "policy": {
          "$ref": "campaign-v2.schema.json#/$defs/policy"
        },
        "reducers": {
          "$ref": "#/$defs/reducers"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replayability": {
          "const": "full"
        },
        "parentFindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "activeReserved",
        "consumedKnown",
        "consumedUnknown",
        "remaining"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "activeReserved": {
          "type": "integer",
          "minimum": 0
        },
        "consumedKnown": {
          "type": "integer",
          "minimum": 0
        },
        "consumedUnknown": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "phase",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "logical",
            "http"
          ]
        },
        "phase": {
          "enum": [
            "discovery",
            "confirmation",
            "shrink",
            "final-confirmation"
          ]
        },
        "state": {
          "enum": [
            "reserved",
            "dispatched",
            "known",
            "unknown",
            "released"
          ]
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "lineageBudgetId",
        "config",
        "elapsedMs",
        "logical",
        "http",
        "phases",
        "reservations"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "lineageBudgetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "config": {
          "$ref": "campaign-v2.schema.json#/$defs/budget"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "logical": {
          "$ref": "#/$defs/balance"
        },
        "http": {
          "$ref": "#/$defs/balance"
        },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discovery",
            "confirmation",
            "shrink",
            "final-confirmation"
          ],
          "properties": {
            "discovery": {
              "$ref": "#/$defs/balance"
            },
            "confirmation": {
              "$ref": "#/$defs/balance"
            },
            "shrink": {
              "$ref": "#/$defs/balance"
            },
            "final-confirmation": {
              "$ref": "#/$defs/balance"
            }
          }
        },
        "reservations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/reservation"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "frozenHash",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "original",
            "shrink"
          ]
        },
        "frozenHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "frozen",
            "complete",
            "inconclusive"
          ]
        }
      }
    },
    "slots": {
