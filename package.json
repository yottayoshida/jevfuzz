{
  "name": "jevfuzz",
  "version": "0.9.0-dev.0",
  "description": "Metamorphic stability testing for Jev decision functions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "jevfuzz": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "fixtures/*.json",
    "fixtures/v2",
    "fixtures/compat-v01",
    "schemas",
    "docs/v09-migration.md",
    "docs/provider-conformance.md",
    "docs/benchmark-v09.md",
    "docs/demo-v09.md",
    "docs/v09-implementation.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yottayoshida/jevfuzz.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "test:live": "node scripts/live-smoke.ts",
    "test:compat": "node --test test/compat-v01.test.ts",
    "test:campaign": "node --test test/*-v2.test.ts",
    "bench:sim": "node scripts/benchmark-v09.ts",
    "demo": "node scripts/demo-v09.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "ajv": "8.17.1",
    "typescript": "^7.0.2"
  }
}
